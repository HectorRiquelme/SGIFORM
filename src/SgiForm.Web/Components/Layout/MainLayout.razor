                            <line x1="18" y1="20" x2="18" y2="10"/>
                            <line x1="12" y1="20" x2="12" y2="4"/>
                            <line x1="6"  y1="20" x2="6"  y2="14"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Reportes</span>
                </NavLink>
            </li>

            <!-- Georreferencia -->
            <li class="sf-nav-section">Georreferencia</li>
            <li>
                <NavLink href="georeferencia/terreno" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
