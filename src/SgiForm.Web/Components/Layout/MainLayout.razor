                            <line x1="9" y1="3" x2="9" y2="18"/>
                            <line x1="15" y1="6" x2="15" y2="21"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">En terreno</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="georeferencia/historica" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Histórica</span>
                </NavLink>
            </li>

            <!-- Administración -->
            <li class="sf-nav-section">Administración</li>
            <li>
                <NavLink href="operadores" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Operadores</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="usuarios" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Usuarios</span>
                </NavLink>
            </li>

        </ul>

        <!-- Footer -->
        <div class="sf-sidebar-footer">
            <div class="sf-user-card">
                <div class="sf-user-avatar">@GetInitials(Auth.Nombre)</div>
                <div class="sf-user-info">
                    <span class="sf-user-name">@Auth.Nombre</span>
                    <span class="sf-user-role">@Auth.Rol</span>
                </div>
            </div>
            <button class="sf-btn-logout" @onclick="Logout">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                Cerrar sesión
            </button>
        </div>
    </nav>

    <!-- ── MAIN ────────────────────────────────────────────────────────── -->
    <main class="sf-main">
        <header class="sf-topbar">
            <button class="sf-menu-toggle" @onclick="ToggleSidebar" title="Toggle menú">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="3" y1="12" x2="21" y2="12"/>
                    <line x1="3" y1="6"  x2="21" y2="6"/>
                    <line x1="3" y1="18" x2="21" y2="18"/>
                </svg>
            </button>

            <div class="sf-topbar-right">
                <div class="sf-topbar-empresa">Sanitaria Demo</div>
            </div>
        </header>

        <div class="sf-page-content">
            <ErrorBoundary>
                <ChildContent>@Body</ChildContent>
                <ErrorContent Context="ex">
                    <div class="sf-alert sf-alert-danger">
                        <strong>Error inesperado:</strong> @ex.Message
                    </div>
                </ErrorContent>
            </ErrorBoundary>
        </div>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Se produjo un error. <a href="." class="reload">Recargar</a>
</div>

@code {
    private bool sidebarColapsado = false;

    protected override void OnInitialized()
    {
        Auth.OnChange += StateHasChanged;
    }

    private void ToggleSidebar() => sidebarColapsado = !sidebarColapsado;

    private static string GetInitials(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "?";
        var parts = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2
            ? $"{parts[0][0]}{parts[1][0]}".ToUpper()
            : parts[0][0].ToString().ToUpper();
    }

    private void Logout()
    {
        Auth.ClearSession();
        var pb = (Config["PathBase"] ?? "").TrimEnd('/');
        Nav.NavigateTo(pb + "/login", forceLoad: true);
    }

    public void Dispose()
    {
        Auth.OnChange -= StateHasChanged;
    }
}
