                        </svg>
                    </span>
                    <span class="sf-nav-label">Asignaciones</span>
                </NavLink>
            </li>

            <!-- Resultados -->
            <li class="sf-nav-section">Resultados</li>
            <li>
                <NavLink href="inspecciones" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 11l3 3L22 4"/>
                            <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/>
                        </svg>
