                            <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Tipos de Inspección</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="flujos" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="12 2 2 7 12 12 22 7 12 2"/>
                            <polyline points="2 17 12 22 22 17"/>
                            <polyline points="2 12 12 17 22 12"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Constructor de Flujos</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="zonas-localidades" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Zonas y Localidades</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="versionamiento" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"/>
                            <line x1="12" y1="8" x2="12" y2="12"/>
                            <line x1="12" y1="16" x2="12.01" y2="16"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Notas de versión</span>
                </NavLink>
            </li>

            <!-- Operaciones -->
            <li class="sf-nav-section">Operaciones</li>
            <li>
                <NavLink href="importaciones" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/>
                            <line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                    </span>
                    <span class="sf-nav-label">Importar Excel</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="servicios" class="sf-nav-item" ActiveClass="active">
                    <span class="sf-nav-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
